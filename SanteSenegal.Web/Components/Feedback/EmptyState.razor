<section class="ds-state" role="status" aria-labelledby="@TitleId">
    <h3 id="@TitleId" class="ds-state__title">@Title</h3>
    <p class="ds-state__message">@Message</p>
    @if (Action is not null)
    {
        <div class="ds-state__action">
            @Action
        </div>
    }
</section>

@code {
    private readonly string _id = $"empty-{Guid.NewGuid():N}";

    [Parameter] public string Title { get; set; } = "Aucun résultat";
    [Parameter] public string Message { get; set; } = "Aucune donnée à afficher pour le moment.";
    [Parameter] public RenderFragment? Action { get; set; }

    private string TitleId => $"{_id}-title";
}
