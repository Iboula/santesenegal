# Variables d'environnement SanteSenegal — Production
# Copiez ce fichier en .env et remplissez les valeurs réelles

# JWT Configuration (minimum 32 caractères)
JWT_SECRET=VotreCleSuperSecreteDe32CaracteresMin!
JWT_ISSUER=SanteSenegal
JWT_AUDIENCE=SanteSenegalMobile

# Base de données (SQLite par défaut en container)
# DB_PATH=/app/data/sante_senegal.db

# Optionnel : PostgreSQL
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=santesenegal
# DB_USER=sante
# DB_PASSWORD=votre_mot_de_passe
