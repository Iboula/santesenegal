{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/data/sante_senegal.db"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "https://app.santesenegal.sn",
      "https://santesenegal.sn",
      "http://localhost:7001",
      "http://localhost:8080"
    ]
  }
}
